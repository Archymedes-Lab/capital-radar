# Copy to .env.local — never commit real keys.
EXA_API_KEY=
# Hours between automatic refreshes (min 1, default 24).
EXA_REFRESH_HOURS=24
# Set to "off" to disable the in-process scheduler (e.g. when using external cron).
EXA_SCHEDULER=on
# If set, POST /api/refresh requires "Authorization: Bearer <value>". Set this before exposing the app.
REFRESH_SECRET=

# Orion (the decision engine that ranks what is worth pursuing). It holds the Jev key; this app never does.
# Start it with: cd ~/orion && bun run server
ORION_API=http://127.0.0.1:3001
# Path to the Orion repo (its deterministic engine is imported from here). Default: ~/orion
ORION_DIR=
# Set to "off" to stop Orion re-ranking automatically after refreshes.
ORION_AUTO=on

# Your company dossier: a plain-text file outside the repo (raise, products, investor feedback, constraints).
# Without it the example in data/dossier.example.md is used.
DOSSIER_FILE=
